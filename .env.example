# Supabase 프로젝트 설정 > API 에서 값을 복사해 .env.local 파일을 만드세요.
# 이 파일(.env.example)은 실제 값 없이 형식만 안내하는 템플릿입니다.

# 브라우저에도 노출되는 공개 값 (NEXT_PUBLIC_ 접두사 필수)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 서버 전용 값. 절대 NEXT_PUBLIC_ 접두사를 붙이지 말고, 브라우저 코드에서 import 하지 마세요.
# 관리자 기능(상담 목록 조회, 배너/공지 등록 등)에서만 사용합니다.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 상담 신청 접수 시 이메일 알림 (선택 사항. 비워두면 알림 없이 기존처럼 DB 저장만 됩니다)
# 1) https://resend.com 무료 가입 후 API Keys 메뉴에서 발급
# 2) 알림을 받을 이메일 주소 입력 (여러 명이면 콤마로 구분: a@a.com,b@b.com)
RESEND_API_KEY=your-resend-api-key
NOTIFY_EMAIL=owner@example.com
# (선택) 발신자 이름/주소. 도메인 인증 전에는 아래 기본값(onboarding@resend.dev)만 사용 가능합니다.
# RESEND_FROM_EMAIL=한국장례서비스 알림 <onboarding@resend.dev>
